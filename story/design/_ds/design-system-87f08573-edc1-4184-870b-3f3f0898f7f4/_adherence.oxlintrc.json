{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "app-data.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Plus Jakarta Sans."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent-aws",
      "--accent-coding",
      "--accent-frontend",
      "--accent-java",
      "--accent-k8s",
      "--accent-microservices",
      "--accent-spring",
      "--accent-sysdesign",
      "--bg",
      "--brand",
      "--brand-ink",
      "--brand-soft",
      "--conf-high",
      "--conf-low",
      "--conf-med",
      "--font-body",
      "--font-display",
      "--ink",
      "--ink-faint",
      "--ink-soft",
      "--line",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--shadow-brand",
      "--shadow-card",
      "--surface",
      "--surface-2"
    ],
    "tokenKinds": {
      "--bg": "color",
      "--surface": "color",
      "--surface-2": "color",
      "--ink": "color",
      "--ink-soft": "color",
      "--ink-faint": "color",
      "--brand": "color",
      "--brand-ink": "color",
      "--brand-soft": "color",
      "--line": "color",
      "--accent-coding": "color",
      "--accent-sysdesign": "color",
      "--accent-microservices": "color",
      "--accent-k8s": "color",
      "--accent-aws": "color",
      "--accent-java": "color",
      "--accent-spring": "color",
      "--accent-frontend": "color",
      "--conf-low": "color",
      "--conf-med": "color",
      "--conf-high": "color",
      "--font-display": "font",
      "--font-body": "font",
      "--radius-lg": "radius",
      "--radius-md": "radius",
      "--radius-sm": "radius",
      "--radius-pill": "radius",
      "--shadow-card": "shadow",
      "--shadow-brand": "shadow"
    },
    "fontFamilies": [
      "Plus Jakarta Sans",
      "Space Grotesk"
    ]
  }
}